{
  "name": "@senzing/trpc",
  "version": "4.5.0-2",
  "license": "Apache-2.0",
  "description": "tRPC routers and client types for remote access to Senzing NAPI bindings",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@senzing/types": ">=4.5.0-0",
    "@trpc/server": "^11.19.0",
    "superjson": "^2",
    "zod": "^4"
  },
  "peerDependencies": {
    "@senzing/sdk": ">=4.5.0-0"
  },
  "peerDependenciesMeta": {
    "@senzing/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@senzing/sdk": ">=4.5.0-0",
    "@trpc/client": "^11.22.1",
    "tsup": "^9",
    "typescript": "^7"
  },
  "files": [
    "dist"
  ]
}
